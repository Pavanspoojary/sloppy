{
  "name": "@sloppy-ai/mcp",
  "version": "1.1.0",
  "description": "Model Context Protocol (MCP) server for Sloppy: The AI Slop UI Fixer",
  "type": "module",
  "bin": {
    "sloppy-mcp": "./bin/sloppy-mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node ./bin/sloppy-mcp.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sloppy-ai/core": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
