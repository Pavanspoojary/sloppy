{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "../../assets/*": ["../../assets/*"],
      "../kit": ["../kit"],
      "../kit/*": ["../kit/*"],
      "../examples/*": ["../../patterns/*"],
      "@sloppy-ai/kit": ["../kit"],
      "@sloppy/kit": ["../kit"],
      "@sloppy-ai/core": ["../core/src"],
      "@sloppy/core": ["../core/src"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["*.ts", "*.tsx"]
}
